# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# For runtime with Row-Level Security:
DATABASE_URL=postgresql://microledger_app:your_password@localhost:5432/microledger
# Optional: Superuser URL for running automated initial schema migrations:
DATABASE_SUPERUSER_URL=postgresql://postgres:your_postgres_password@localhost:5432/microledger

# Redis Cache URL (Optional - application automatically falls back to PostgreSQL transactions if Redis is unavailable)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secure_secret_key_here
JWT_EXPIRES_IN=8h
